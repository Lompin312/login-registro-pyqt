/* =========================================================
   Hoja de estilos global (Qt Style Sheets - QSS)
   TP Login y Registro con PyQt6 y Qt Designer
   ========================================================= */

/* Fondo general de la ventana principal y las pantallas */
QStackedWidget, QWidget#pantalla_login, QWidget#pantalla_registro {
    background-color: #e7eaef;
    font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #111a26;
}

/* Tarjeta central contenedora (selector específico para no afectar QLabel) */
QFrame#frame_tarjeta {
    background-color: #fbfcfd;
    border: 1px solid #ccd4e0;
    border-radius: 16px;
}

/* Jerarquía tipográfica y colores explícitos (evita problemas con modo oscuro del SO) */
QLabel {
    color: #1e293b;
    background-color: transparent;
    border: none;
    font-weight: 500;
}

QLabel#label_titulo {
    color: #0f172a;
    font-size: 22px;
    font-weight: 700;
    padding-bottom: 2px;
}

QLabel#label_subtitulo {
    color: #64748b;
    font-size: 13px;
    font-weight: 400;
    padding-bottom: 8px;
}

/* Campos de entrada (QLineEdit) y estados :focus e [invalido="true"] */
QLineEdit {
    background-color: #ffffff;
    color: #111a26;
    border: 1px solid #ccd4e0;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: #1548c8;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border: 2px solid #1548c8;
    padding: 7px 9px;
}

QLineEdit[invalido="true"] {
    border: 2px solid #b7361b;
    background-color: #fff8f6;
    padding: 7px 9px;
}

/* Casillas de verificación (QCheckBox) */
QCheckBox {
    color: #334155;
    spacing: 8px;
    padding: 2px 0px;
}

/* Botones principales (Login y Registro) y sus estados */
QPushButton#btn_login, QPushButton#btn_registrar {
    background-color: #1548c8;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 11px 16px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#btn_login:hover, QPushButton#btn_registrar:hover {
    background-color: #1240ad;
}

QPushButton#btn_login:pressed, QPushButton#btn_registrar:pressed {
    background-color: #0e3590;
}

QPushButton#btn_login:disabled, QPushButton#btn_registrar:disabled {
    background-color: #9aa9bd;
    color: #e2e8f0;
}

/* Botones secundarios de navegación (estilo enlace) */
QPushButton#btn_ir_registro, QPushButton#btn_volver_login {
    background-color: transparent;
    color: #1548c8;
    border: none;
    padding: 6px 8px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#btn_ir_registro:hover, QPushButton#btn_volver_login:hover {
    color: #0e3590;
    text-decoration: underline;
    background-color: #eef2ff;
    border-radius: 6px;
}

/* Mensajes de validación y estado (error, éxito, info) */
QLabel#label_mensaje {
    font-size: 12px;
    padding: 4px 2px;
}

QLabel#label_mensaje[tipo="error"] {
    color: #b7361b;
    font-weight: 600;
}

QLabel#label_mensaje[tipo="exito"] {
    color: #0f7d55;
    font-weight: 600;
}

QLabel#label_mensaje[tipo="info"] {
    color: #334155;
    font-weight: 500;
}

/* Indicador de fortaleza de contraseña (Desafío Nivel 3) */
QLabel#label_fortaleza {
    font-size: 11px;
    font-weight: 600;
    padding: 1px 2px;
}

QLabel#label_fortaleza[nivel="debil"] {
    color: #b7361b;
}

QLabel#label_fortaleza[nivel="aceptable"] {
    color: #b45309;
}

QLabel#label_fortaleza[nivel="fuerte"] {
    color: #0f7d55;
}